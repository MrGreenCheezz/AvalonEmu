// The start of a new character under Progression:NewCharacters = FairStart (config/world.jsonc): an empty destiny
// board, so only what it allows — items.xml unlockedtoequip T1 items — may be equipped. START (45 fame) unlocks the T2
// bag and cape, COMBAT_TRAINEE (250 kill fame) the T2 sword, bow, fire staff, shield, book and SET1 armours; the rest
// comes with the destiny board as fame fills it. Same format as starter.json; a missing key keeps the built-in value shown here.
{
  "Cluster": "0000",          // world.xml cluster id; 0000 = Thetford
  "Position": [0, 0],         // Join key 9
  "Equipment": {              // by slot: mainhand, offhand, head, armor, shoes, bag, cape, mount, potion, food
    "mainhand": "T1_MAIN_SWORD",
    "offhand": "T1_OFF_SHIELD",
    "head": "T1_HEAD_LEATHER_SET1",
    "armor": "T1_ARMOR_LEATHER_SET1",
    "shoes": "T1_SHOES_LEATHER_SET1"
  },
  "Inventory": [              // slots in order, null = empty slot
    "T1_2H_TOOL_AXE",
    "T1_2H_TOOL_PICK",
    "T1_2H_TOOL_SICKLE",
    "T1_2H_TOOL_HAMMER",
    "T1_2H_TOOL_KNIFE"
  ]
}
