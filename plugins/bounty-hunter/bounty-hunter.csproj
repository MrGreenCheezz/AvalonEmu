<Project Sdk="Microsoft.NET.Sdk">

  <!--
    For the IDE only (IntelliSense, a local build to check): the server builds this folder's *.cs with a project of its own
    (data/plugins-bin/<name>/build/), whatever this file says. Copy it into a new plugin folder as a template.
    AlbionPluginApi: the API assembly; the default is the one `dotnet build` of the server solution makes.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <NuGetAudit>false</NuGetAudit>
    <AlbionPluginApi Condition="'$(AlbionPluginApi)' == ''">$(MSBuildThisFileDirectory)../../src/AlbionLocal.Plugin.Api/bin/Debug/net10.0/AlbionLocal.Plugin.Api.dll</AlbionPluginApi>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="AlbionLocal.Plugin.Api">
      <HintPath>$(AlbionPluginApi)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
