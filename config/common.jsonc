// JSONC (JSON with comments), including trailing commas; not standard JSON.
// Optional keys use preset defaults.
// Relative paths use the parent of this configuration directory.
// Command-line overrides: --Section:Key=value. Restart applies file edits.
{
  // Preset supplies defaults for omitted options: official (the official game; also when this key is missing) or pve.
  "Preset": "official",
  "Network": {
    "BindAddress": "127.0.0.1"
    // "PublicAddress": "192.168.1.10", // Required when listening on 0.0.0.0.
  },
  "Paths": {
    "ClientGameData": "../game-local/Albion-Online_Data/StreamingAssets/GameData",
    "Content": "content"
  },
  // "Web": { "Enabled": false, "BindAddress": "127.0.0.1", "Port": 8080, "Registration": true, "SessionMinutes": 30 }, // the web panel; Preset pve: Enabled true
  // "Backup": { "EveryHours": 0, "Keep": 10 },
  "Log": { "Level": "Info", "File": "data/server.log" } // Empty File means console only.
}
