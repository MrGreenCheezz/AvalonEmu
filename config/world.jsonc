// JSONC (JSON with comments), including trailing commas; not standard JSON.
// Optional keys use preset defaults.
// Relative paths use the parent of this configuration directory.
// Command-line overrides: --Section:Key=value. Restart applies file edits.
{
  "Network": { "GamePort": 5056 },
  "Tutorial": { "Opening": true },  // new characters start in the tutorial, as officially (also without the key, both presets); false = content/starter.json
  "World": {
    "LogoutSeconds": 10,      // logout countdown (cities and safe areas: 10)
    "TickMs": 50              // world loop period; a tick that holds the lock over 20 ms is logged
    // "EventLayers": [],     // seasonal cluster layers to switch on: halloween, christmas, easter, anniversary, anniversary_prelude
    // "AnnounceAll": false,  // debug: every world object of the cluster at Join, never a Leave (rendering vs visibility problems)
    // "MapIdleUnloadMinutes": 5, // a cluster without players is unloaded after this (0 = never); the next Join builds it anew
    // (MobRespawnScale moved: Rates:Respawn below is its speed, 1 / the old factor; the old key is still read that way)
    // "OpenWorldChests": true, // POI chests, boss reward chests and camp chests with their local quests (README "Open-world chests and camps")
    // "RareResources": true, // enchanted (rare) resource node states; false = every node plain
    // "MobAi": true,         // mobs aggro, chase, hit back, leash home and roam (stage 5d); false = they stand and only take damage (.mob ai on|off)
  },
  // Rate modifiers multiply existing game rewards. .rates <name> <value> changes one temporarily
  // while running (Admin); restarting restores configuration values. No command saves changes.
  "Rates": {
    "Fame": 1,            // every fame gain (kills, harvests, crafts, tomes); the three below multiply with it
    "CombatFame": 1,      // fame of mob kills (3 = three times the UpdateFame of a kill)
    "GatheringFame": 1,   // fame of harvests
    "CraftingFame": 1,    // fame of crafts
    "Harvest": 1,         // resources a harvest yields, nodes and corpses (1.5 of 3 = 4 or 5, the fraction at random)
    "Silver": 1,          // a killed mob's silver pile and silver-giving items (awardsilver)
    "Loot": 1,            // item drop chances of mob kills and opened chests; not applied again to Loot:BlackMarketChance
    "Respawn": 1,         // mob respawn speed: 2 = back in half the time, 100 = seconds (the old World:MobRespawnScale 0.01)
    "Regrowth": 1,        // resource node regrowth speed: 2 = a charge back in half the time
    "CraftingReturn": 1,  // factor on the share of resources a craft gives back (Crafting:Returns; at most all)
    "ChampionWeight": 1,  // weight of champion, miniboss and boss mobs in a RANDOM spawn point's pick (Preset pve: 2)
    "ChestRespawn": 1     // open-world chest respawn and reroll speed: 2 = back in half the time
  }
