// AlbionLocal server settings. Every key is optional; a missing key keeps the default shown here.
// Any key can be overridden on the command line: --Section:Key=value (e.g. --Log:Level=Debug).
// Relative paths are taken from the folder the server is started in (server/).
{
  // The rule set the keys below default to: "pve" (this server's default; PvP only by consent, no deaths or full loot, more loot
  // and fame, see README "PvE preset") or "official" (the official rules and rates). A key given here or on the command line wins.
  "Preset": "pve",
  "Network": {
    "LoginPort": 5055,        // login server port
    "GamePort": 5056,
    "ChatPort": 5057,         // the chat server (channels and whispers; README "Chat"): open it next to the other two for remote friends
    "BindAddress": "127.0.0.1", // IPv4 the listeners bind to; "0.0.0.0" = every interface (other PCs on the LAN, see README)
    // "PublicAddress": "192.168.1.10", // game server address given to clients (default: BindAddress; required with 0.0.0.0)
  },
  "World": {
    "LogoutSeconds": 10,      // logout countdown (cities and safe areas: 10)
    "TickMs": 50,             // world loop period; a tick that holds the lock over 20 ms is logged
    // "EventLayers": [],     // seasonal cluster layers to switch on: halloween, christmas, easter, anniversary, anniversary_prelude
    // "AnnounceAll": false,  // debug: every world object of the cluster at Join, never a Leave (rendering vs visibility problems)
    // "MapIdleUnloadMinutes": 5, // a cluster without players is unloaded after this (0 = never); the next Join builds it anew
    // (MobRespawnScale moved: Rates:Respawn below is its speed, 1 / the old factor; the old key is still read that way)
    // "OpenWorldChests": true, // POI chests, boss reward chests and camp chests with their local quests (README "Open-world chests and camps")
    // "MobAi": true,         // mobs aggro, chase, hit back, leash home and roam (stage 5d); false = they stand and only take damage (.mob ai on|off)
  },
  // Rate modifiers, all 1 under Preset official (the official numbers); Preset pve: Fame 2, Silver 1.5, Loot 1, Respawn 2, Harvest 1.5, Regrowth 2, ChampionWeight 2. Fractions allowed; .rates shows them, .rates <name> <value> [save] changes one
