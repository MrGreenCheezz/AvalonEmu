  // "Rates": {
  //   "Fame": 1,            // every fame gain (kills, harvests, crafts, tomes); the three below multiply with it
  //   "CombatFame": 1,      // fame of mob kills (3 = three times the UpdateFame of a kill)
  //   "GatheringFame": 1,   // fame of harvests
  //   "CraftingFame": 1,    // fame of crafts
  //   "Harvest": 1,         // resources a harvest yields, nodes and corpses (1.5 of 3 = 4 or 5, the fraction at random)
  //   "Silver": 1,          // a killed mob's silver pile and silver-giving items (awardsilver)
  //   "Loot": 1,            // item drop chances of mob kills and opened chests (once, on the loot factor; not on Loot:BlackMarketChance); not the loot of opened items
  //   "Respawn": 1,         // mob respawn speed: 2 = back in half the time, 100 = seconds (the old World:MobRespawnScale 0.01)
  //   "Regrowth": 1,        // resource node regrowth speed: 2 = a charge back in half the time
  //   "CraftingReturn": 1,  // factor on the share of resources a craft gives back (Crafting:Returns; at most all)
  //   "ChampionWeight": 1,  // weight of champion, miniboss and boss mobs in a RANDOM spawn point's pick (Preset pve: 2)
  //   "ChestRespawn": 1,    // open-world chest respawn and reroll speed: 2 = back in half the time
  // },
  // "Visibility": { "CellSize": 10, "EnterCells": 4, "LeaveCells": 6 }, // world objects: 10 m cells on the cluster origin, sent within 4 cells, left from 6 (5 = no hysteresis)
  // "Transfer": { "PositionTolerance": 2, "CheckExitCooldown": true }, // exits: metres allowed outside the exit square; refuse an exit used within 1 s (city) / 10 s of the Join
  "Paths": {
    // the client's GameData folder: items, spells, stats and destiny board are read from its .bin files at startup
    "ClientGameData": "../game-local/Albion-Online_Data/StreamingAssets/GameData",
    "Saves": "data",          // albionlocal.db (characters; a characters.json there is imported once), clientdata.json (client build and hashes of the last start)
    "Content": "content"      // server content: starter.json (start cluster, position and kit of new characters), opcode-stubs.json (answers of side requests)
  },
  "Log": {
    "Level": "Info",          // Trace, Debug, Info, Warn, Error; -v / -vv on the command line win
    "File": "data/server.log" // the log lines are appended here too (follow with tail -F); "" = console only
  },
