<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AlbionLocal.Photon\AlbionLocal.Photon.csproj" />
    <ProjectReference Include="..\AlbionLocal.Protocol\AlbionLocal.Protocol.csproj" />
    <ProjectReference Include="..\AlbionLocal.Modules.Api\AlbionLocal.Modules.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Keep the SQLite native library and provider on a patched, matching 2.1.x bundle.
         Microsoft.Data.Sqlite 10.0.8 otherwise resolves the vulnerable 2.1.11 native library (CVE-2025-6965). -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.8" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.14" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
  </PropertyGroup>

</Project>
